# PORT: Port assigned by Render or hosting environment (Defaults to 3000 if not set)
PORT=3000

# NODE_ENV: Set to 'production' on Render
NODE_ENV=production

# JWT_SECRET: Secret used for signing authentication tokens
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# MONGODB_URI: MongoDB Atlas connection string for persistent cloud database
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/beauty_db?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Push Notification VAPID Keys (Auto-generated and persisted in MongoDB if left blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dedlek456@gmail.com

# Optional: Gemini API Key if AI features are used
GEMINI_API_KEY=
